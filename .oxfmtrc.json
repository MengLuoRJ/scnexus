{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.vue"],
      "options": {
        "htmlWhitespaceSensitivity": "ignore",
        "bracketSameLine": true
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/dist-ssr/**",
    "**/build/**",
    "**/vendor/**",
    "packages/bzip2-wasm/native/bzip2-1.0.8/**",
    "**/coverage/**",
    "**/release/**",
    "**/.cache/**",
    "**/.nuxt-ui/**",
    "**/stats.html",
    "**/auto-imports.d.ts",
    "**/components.d.ts",
    "**/.electron-vendors.cache.json",
    "pnpm-lock.yaml",
    ".agents/**",
    ".github/skills/**"
  ]
}
