{
  "name": "scnexus",
  "version": "0.1.0-snapshot",
  "description": "SCNexus Client",
  "keywords": [
    "SCNexus"
  ],
  "author": "MengLuoRJ <mengluorj@aiurcovenant.net>",
  "repository": {
    "type": "git",
    "url": "https://github.com/MengLuoRJ/scnexus.git"
  },
  "type": "module",
  "main": "packages/app-main/dist/index.js",
  "scripts": {
    "dev": "pnpm run build:prepare && tsx scripts/dev-watch.ts",
    "build": "pnpm run build:prepare && pnpm run typecheck && pnpm run build:main && pnpm run build:preload && pnpm run build:renderer",
    "build:main": "pnpm --filter @scnexus/app-main build",
    "build:preload": "pnpm --filter @scnexus/app-preload build",
    "build:renderer": "pnpm --filter @scnexus/app-renderer-v2 build-only",
    "build:standard": "pnpm --filter @scnexus/standard build",
    "build:app:prepare": "pnpm run script:app:sync-version",
    "build:app": "pnpm run build:app:prepare && cross-env MODE=production pnpm run build && pnpm --filter @scnexus/app-main build:app",
    "build:app:release": "pnpm run build:app:prepare && cross-env MODE=production pnpm run build && pnpm --filter @scnexus/app-main build:app:release",
    "test": "pnpm run build:standard && pnpm run test:build && pnpm run test:main && pnpm run test:preload && pnpm run test:renderer",
    "test:main": "pnpm --filter @scnexus/app-main test",
    "test:preload": "vitest run -r packages/app-preload",
    "test:renderer": "pnpm --filter @scnexus/app-renderer-v2 test:unit --run",
    "lint": "pnpm lint:oxlint && pnpm lint:eslint",
    "typecheck": "pnpm run typecheck:shared && pnpm run typecheck:main && pnpm run typecheck:preload && pnpm run typecheck:renderer",
    "typecheck:main": "tsc --noEmit -p packages/app-main/tsconfig.json",
    "typecheck:preload": "tsc --noEmit -p packages/app-preload/tsconfig.json",
    "typecheck:renderer": "pnpm --filter @scnexus/app-renderer-v2 type-check",
    "postinstall": "pnpm run script:electron:targets",
    "format": "oxfmt --write --disable-nested-config .",
    "script:app:sync-version": "tsx scripts/sync-app-packages-version.ts",
    "lint:oxlint": "oxlint -c .oxlintrc.json .",
    "lint:eslint": "eslint .",
    "lint:fix": "pnpm lint:oxlint --fix && pnpm lint:eslint --fix",
    "format:check": "oxfmt --check --disable-nested-config .",
    "build:prepare": "pnpm run script:electron:targets && pnpm run build:standard",
    "script:electron:targets": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/update-electron-vendors.js",
    "typecheck:shared": "tsc --noEmit -p packages/app-shared/tsconfig.json",
    "test:build": "node --test scripts/__tests__/build-workflow.test.mjs scripts/__tests__/sevenzip-platform.test.mjs"
  },
  "devDependencies": {
    "@scnexus/app-main": "workspace:*",
    "@scnexus/app-shared": "workspace:*",
    "@types/node": "^24.19.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "cross-env": "^7.0.3",
    "electron": "^44.5.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "globals": "^17.13.0",
    "oxfmt": "^0.67.0",
    "oxlint": "~1.82.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=11.0.0"
  }
}