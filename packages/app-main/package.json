{
  "name": "@scnexus/app-main",
  "version": "0.0.21",
  "description": "electron main process",
  "author": {
    "name": "MengLuoRJ",
    "email": "mengluorj@aiurcovenant.net",
    "url": "https://github.com/MengLuoRJ"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MengLuoRJ/scnexus"
  },
  "type": "module",
  "main": "packages/app-main/dist/index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build:app": "cross-env MODE=production && electron-builder build --config electron-builder.json --dir --config.asar=false",
    "build:app:release": "cross-env MODE=production && electron-builder build --config electron-builder.json",
    "lint": "pnpm -w exec oxlint -c .oxlintrc.json packages/app-main && pnpm -w exec eslint packages/app-main",
    "lint:oxlint": "pnpm -w exec oxlint -c .oxlintrc.json packages/app-main",
    "lint:eslint": "pnpm -w exec eslint packages/app-main",
    "lint:fix": "pnpm -w exec oxlint -c .oxlintrc.json packages/app-main --fix && pnpm -w exec eslint packages/app-main --fix",
    "format": "pnpm -w exec oxfmt --write --disable-nested-config packages/app-main",
    "format:check": "pnpm -w exec oxfmt --check --disable-nested-config packages/app-main"
  },
  "dependencies": {
    "7z-bin": "0.0.3",
    "@scnexus/standard": "workspace:*",
    "@sentry/electron": "^8.0.0",
    "axios": "^1.20.0",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.3.9",
    "filesize": "^10.1.6",
    "hash-wasm": "^4.12.0",
    "regedit": "^5.1.3",
    "semver": "^7.6.3",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@scnexus/app-shared": "workspace:*",
    "@types/semver": "^7.5.8",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "scnexus-standard": "^0.0.13",
    "typescript": "^5.7.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
