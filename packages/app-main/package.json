{
  "name": "@scnexus/app-main",
  "version": "0.1.0-snapshot.7",
  "description": "electron main process",
  "author": {
    "name": "MengLuoRJ",
    "email": "mengluorj@aiurcovenant.net",
    "url": "https://github.com/MengLuoRJ"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MengLuoRJ/scnexus"
  },
  "type": "module",
  "main": "packages/app-main/dist/index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build:app": "node scripts/verify-build.mjs && electron-builder build --config electron-builder.mjs --dir --publish never",
    "build:app:release": "node scripts/verify-build.mjs && electron-builder build --config electron-builder.mjs --publish never",
    "lint": "pnpm -w exec oxlint -c .oxlintrc.json packages/app-main && pnpm -w exec eslint packages/app-main",
    "lint:oxlint": "pnpm -w exec oxlint -c .oxlintrc.json packages/app-main",
    "lint:eslint": "pnpm -w exec eslint packages/app-main",
    "lint:fix": "pnpm -w exec oxlint -c .oxlintrc.json packages/app-main --fix && pnpm -w exec eslint packages/app-main --fix",
    "format": "pnpm -w exec oxfmt --write --disable-nested-config packages/app-main",
    "format:check": "pnpm -w exec oxfmt --check --disable-nested-config packages/app-main",
    "build": "vite build"
  },
  "dependencies": {
    "7z-bin": "26.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@scnexus/replay-parser": "workspace:*",
    "@scnexus/standard": "workspace:*",
    "@sentry/electron": "^8.3.0",
    "ajv": "^8.20.0",
    "axios": "^1.21.0",
    "electron-log": "^5.4.4",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "filesize": "^11.0.29",
    "hash-wasm": "^4.12.0",
    "regedit": "^5.1.4",
    "seek-bzip": "^2.0.0",
    "semver": "^7.8.5",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@scnexus/app-shared": "workspace:*",
    "@types/semver": "^7.8.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
