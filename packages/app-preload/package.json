{
  "name": "@scnexus/app-preload",
  "version": "0.1.0-snapshot.2",
  "description": "electron preload process",
  "author": {
    "name": "MengLuoRJ",
    "email": "mengluorj@aiurcovenant.net",
    "url": "https://github.com/MengLuoRJ"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MengLuoRJ/scnexus"
  },
  "type": "module",
  "main": "dist/index.mjs",
  "scripts": {
    "lint": "pnpm -w exec oxlint -c .oxlintrc.json packages/app-preload && pnpm -w exec eslint packages/app-preload",
    "lint:oxlint": "pnpm -w exec oxlint -c .oxlintrc.json packages/app-preload",
    "lint:eslint": "pnpm -w exec eslint packages/app-preload",
    "lint:fix": "pnpm -w exec oxlint -c .oxlintrc.json packages/app-preload --fix && pnpm -w exec eslint packages/app-preload --fix",
    "format": "pnpm -w exec oxfmt --write --disable-nested-config packages/app-preload",
    "format:check": "pnpm -w exec oxfmt --check --disable-nested-config packages/app-preload",
    "build": "vite build"
  },
  "dependencies": {
    "@scnexus/app-shared": "workspace:*"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "typescript": "^5.7.2",
    "vite": "^8.3.2"
  }
}
