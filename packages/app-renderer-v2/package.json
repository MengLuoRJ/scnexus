{
  "name": "@scnexus/app-renderer-v2",
  "version": "0.1.0",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "pnpm -w exec oxlint -c .oxlintrc.json packages/app-renderer-v2 && pnpm -w exec eslint packages/app-renderer-v2",
    "lint:oxlint": "pnpm -w exec oxlint -c .oxlintrc.json packages/app-renderer-v2",
    "lint:eslint": "pnpm -w exec eslint packages/app-renderer-v2",
    "format": "pnpm -w exec oxfmt --write --disable-nested-config packages/app-renderer-v2",
    "lint:fix": "pnpm -w exec oxlint -c .oxlintrc.json packages/app-renderer-v2 --fix && pnpm -w exec eslint packages/app-renderer-v2 --fix",
    "format:check": "pnpm -w exec oxfmt --check --disable-nested-config packages/app-renderer-v2"
  },
  "dependencies": {
    "@comark/vue": "^0.8.1",
    "@iconify/vue": "^5.0.4",
    "@nuxt/ui": "^4.12.0",
    "@scnexus/app-shared": "workspace:*",
    "@sentry/electron": "8.3.0",
    "@sentry/vue": "11.8.0",
    "@tiptap/core": "^3.31.4",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.21.0",
    "comark": "^0.8.1",
    "motion-v": "^2.10.0",
    "pinia": "^4.1.0",
    "semver": "^7.8.5",
    "tailwindcss": "^4.3.3",
    "uqr": "^0.1.3",
    "uuid": "^14.0.3",
    "vccs": "^1.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iconify-json/tabler": "^1.2.43",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.4",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
