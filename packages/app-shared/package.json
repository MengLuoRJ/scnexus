{
  "name": "@scnexus/app-shared",
  "version": "0.1.1",
  "description": "shared codes",
  "license": "BSD-3-Clause",
  "author": {
    "name": "MengLuoRJ",
    "email": "mengluorj@aiurcovenant.net",
    "url": "https://github.com/MengLuoRJ"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MengLuoRJ/scnexus"
  },
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "./src/*.ts"
      ]
    }
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "lint": "pnpm -w exec oxlint -c .oxlintrc.json packages/app-shared && pnpm -w exec eslint packages/app-shared",
    "lint:oxlint": "pnpm -w exec oxlint -c .oxlintrc.json packages/app-shared",
    "lint:eslint": "pnpm -w exec eslint packages/app-shared",
    "lint:fix": "pnpm -w exec oxlint -c .oxlintrc.json packages/app-shared --fix && pnpm -w exec eslint packages/app-shared --fix",
    "format": "pnpm -w exec oxfmt --write --disable-nested-config packages/app-shared",
    "format:check": "pnpm -w exec oxfmt --check --disable-nested-config packages/app-shared"
  },
  "dependencies": {
    "@scnexus/replay-parser": "workspace:*",
    "@scnexus/sc2-observer": "workspace:*",
    "@scnexus/standard": "workspace:*"
  }
}
