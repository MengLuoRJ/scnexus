{
  "name": "@scnexus/bzip2-wasm",
  "version": "0.1.0",
  "private": true,
  "description": "Synchronous bounded libbz2 WebAssembly decoder",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:wasm": "node scripts/build-wasm.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
