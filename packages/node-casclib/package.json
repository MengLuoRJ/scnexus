{
  "name": "@scnexus/node-casclib",
  "version": "0.0.21",
  "description": "Worker-backed Node-API bindings for CascLib",
  "license": "MIT",
  "type": "module",
  "gypfile": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "build/Release/*.node",
    "src",
    "test",
    "tsconfig.json",
    "binding.gyp",
    "scripts",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:native && npm run build:ts",
    "build:native": "node scripts/prepare-native.mjs && node-gyp rebuild",
    "build:ts": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "node-addon-api": "8.9.2"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "node-gyp": "13.1.0",
    "typescript": "5.7.2"
  }
}