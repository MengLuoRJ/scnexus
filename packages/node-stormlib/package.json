{
  "name": "@scnexus/node-stormlib",
  "version": "0.0.21",
  "description": "Worker-backed Node-API bindings for StormLib",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "build/Release/*.node",
    "src",
    "test",
    "tsconfig.json",
    "CMakeLists.txt",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:native && npm run build:ts",
    "build:native": "cmake-js compile",
    "build:ts": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "node-addon-api": "8.9.2"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "cmake-js": "8.0.0",
    "typescript": "5.7.2"
  }
}