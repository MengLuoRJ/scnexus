{
  "name": "@scnexus/node-stormlib",
  "version": "0.0.21",
  "description": "Worker-backed Node-API bindings for StormLib",
  "license": "MIT",
  "files": [
    "dist",
    "build/Release/*.node",
    "src",
    "test",
    "tsconfig.json",
    "binding.gyp",
    "scripts",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compat": {
      "types": "./dist/compat/index.d.ts",
      "import": "./dist/compat/index.js"
    },
    "./bindings": {
      "types": "./dist/compat/bindings.d.ts",
      "import": "./dist/compat/bindings.js"
    },
    "./constants": {
      "types": "./dist/compat/constants.d.ts",
      "import": "./dist/compat/constants.js"
    }
  },
  "scripts": {
    "install": "node -e \"console.log('Native build skipped; run pnpm run build explicitly')\"",
    "build": "npm run build:native && npm run build:ts",
    "build:native": "node scripts/prepare-native.mjs && node-gyp rebuild",
    "build:ts": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "lint": "pnpm -w exec oxlint -c .oxlintrc.json packages/node-stormlib && pnpm -w exec eslint packages/node-stormlib",
    "lint:oxlint": "pnpm -w exec oxlint -c .oxlintrc.json packages/node-stormlib",
    "lint:eslint": "pnpm -w exec eslint packages/node-stormlib",
    "lint:fix": "pnpm -w exec oxlint -c .oxlintrc.json packages/node-stormlib --fix && pnpm -w exec eslint packages/node-stormlib --fix",
    "format": "pnpm -w exec oxfmt --write --disable-nested-config packages/node-stormlib",
    "format:check": "pnpm -w exec oxfmt --check --disable-nested-config packages/node-stormlib"
  },
  "dependencies": {
    "node-addon-api": "8.9.2"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "node-gyp": "13.1.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "gypfile": false
}
