{
  "name": "@scnexus/replay-parser",
  "version": "0.1.0-snapshot.7",
  "description": "SC2 replay file detection, archive component inspection and metadata extraction",
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "./src/*.ts"
      ]
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "pnpm -w exec oxlint -c .oxlintrc.json packages/replay-parser && pnpm -w exec eslint packages/replay-parser",
    "lint:oxlint": "pnpm -w exec oxlint -c .oxlintrc.json packages/replay-parser",
    "lint:eslint": "pnpm -w exec eslint packages/replay-parser",
    "lint:fix": "pnpm -w exec oxlint -c .oxlintrc.json packages/replay-parser --fix && pnpm -w exec eslint packages/replay-parser --fix",
    "format": "pnpm -w exec oxfmt --write --disable-nested-config packages/replay-parser",
    "format:check": "pnpm -w exec oxfmt --check --disable-nested-config packages/replay-parser"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
