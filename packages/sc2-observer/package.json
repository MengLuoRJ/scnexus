{
  "name": "@scnexus/sc2-observer",
  "version": "0.1.0",
  "description": "Pure externally-clocked StarCraft II replay spatial observer",
  "license": "MIT",
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "pnpm -w exec vitest run --root packages/sc2-observer",
    "lint": "pnpm -w exec oxlint -c .oxlintrc.json packages/sc2-observer && pnpm -w exec eslint packages/sc2-observer",
    "format:check": "pnpm -w exec oxfmt --check --disable-nested-config packages/sc2-observer"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
