{
  "name": "@scnexus/standard",
  "version": "0.1.1",
  "description": "SCNexus package standard: types, JSON Schema, validators and parsers.",
  "keywords": [
    "package-format",
    "schema",
    "scnexus",
    "standard",
    "starcraft"
  ],
  "homepage": "https://github.com/MengLuoRJ/scnexus/blob/main/packages/standard/README.md",
  "bugs": {
    "url": "https://github.com/MengLuoRJ/scnexus/issues"
  },
  "license": "BSD-3-Clause",
  "author": {
    "name": "MengLuoRJ",
    "email": "mengluorj@aiurcovenant.net",
    "url": "https://github.com/MengLuoRJ"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MengLuoRJ/scnexus.git",
    "directory": "packages/standard"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "typesVersions": {
    "*": {
      "package": [
        "./dist/package/index.d.ts"
      ]
    }
  },
  "exports": {
    "./package.schema.json": "./dist/package.schema.json",
    "./package": {
      "import": {
        "types": "./dist/package/index.d.ts",
        "default": "./dist/package/index.js"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "build:schema": "node scripts/generate-schema.mjs",
    "watch": "tsdown --watch src",
    "prepublishOnly": "npm run build",
    "lint": "pnpm -w exec oxlint -c .oxlintrc.json packages/standard && pnpm -w exec eslint packages/standard",
    "lint:oxlint": "pnpm -w exec oxlint -c .oxlintrc.json packages/standard",
    "lint:eslint": "pnpm -w exec eslint packages/standard",
    "lint:fix": "pnpm -w exec oxlint -c .oxlintrc.json packages/standard --fix && pnpm -w exec eslint packages/standard --fix",
    "format": "pnpm -w exec oxfmt --write --disable-nested-config packages/standard",
    "format:check": "pnpm -w exec oxfmt --check --disable-nested-config packages/standard",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ts-json-schema-generator": "^2.9.0",
    "tsdown": "0.23.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
